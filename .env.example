# Copia este archivo como .env para docker-compose.

# Base de datos Postgres externa
DB_HOST=tu-host-postgres
DB_PORT=5432
DB_DATABASE=creditos
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave

# Backend
JWT_SECRET=cambia-esta-clave-larga
JWT_EXPIRES_IN=8h
SEED_PASSWORD=creditos123
DELETE_PASSWORD=eliminar

# Debe apuntar al dominio publico del frontend en produccion.
CORS_ORIGIN=https://creditos.grupo-santacruz.com

# URL publica del frontend, usada para armar el link que se envia al cliente.
APP_URL=https://creditos.grupo-santacruz.com

# Horas de validez del enlace de invitacion.
INVITACION_HORAS=24

# Envio de correos (Gmail). SMTP_PASSWORD es una "contrasena de aplicacion".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=creditos.gruposantacruz@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion-de-gmail
SMTP_FROM=creditos.gruposantacruz@gmail.com

# Administrador inicial (se crea al arrancar si no existe ninguno).
ADMIN_EMAIL=admin@creditos.com
ADMIN_PASSWORD=cambia-esta-clave
