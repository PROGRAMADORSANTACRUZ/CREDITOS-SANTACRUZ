# Puerto de la API
PORT=4001

# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5174

# Autenticacion (JWT)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h
# Password por defecto asignada a los usuarios semilla en db:init
SEED_PASSWORD=creditos123

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=creditos
DB_USER=postgres
DB_PASSWORD=

# URL publica del frontend (para armar el link de la solicitud enviado al cliente)
APP_URL=http://localhost:5174
# Horas de validez del enlace enviado al cliente
INVITACION_HORAS=24

# SSO con la Suite Santa Cruz
# URL base del BACKEND de la suite (donde se canjea el ticket).
SUITE_URL=http://localhost:8000
# Debe ser IDENTICO al SSO_SHARED_SECRET de la suite.
SSO_SHARED_SECRET=

# SMTP para el envio de correos (invitaciones a clientes)
# Configuracion para Hotmail / Outlook.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@hotmail.com
SMTP_PASSWORD=tu-contrasena
SMTP_FROM=Carnes Santacruz <tu-correo@hotmail.com>
